{
  "name": "specforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "specforge": "./src/cli.ts"
  },
  "scripts": {
    "parse": "node --experimental-strip-types ./src/cli.ts parse .",
    "compose": "node --experimental-strip-types ./src/cli.ts compose .",
    "ingest": "node --experimental-strip-types ./src/cli.ts ingest .",
    "validate": "node --experimental-strip-types ./src/cli.ts validate .",
    "ui:server": "node --experimental-strip-types ./src/server.ts",
    "ui:client": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test ./tests/discovery.test.ts ./tests/parser.test.ts ./tests/overlay.test.ts ./tests/validation.test.ts ./tests/ingest.test.ts ./tests/inference.test.ts ./tests/drift-fixtures.test.ts ./tests/cli.test.ts ./tests/api.test.ts ./tests/ui-state.test.ts ./tests/recommendation.test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
